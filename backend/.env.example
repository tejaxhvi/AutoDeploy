# Name of an existing Google Cloud Storage bucket.
GCS_BUCKET=your-bucket-name

# Optional outside Google Cloud when project cannot be inferred from credentials.
GOOGLE_CLOUD_PROJECT=your-project-id

# Local development only: absolute path to a service-account JSON file.
# Prefer an attached service account or Workload Identity in production.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

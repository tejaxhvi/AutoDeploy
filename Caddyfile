api.yourdomain.com {
	reverse_proxy localhost:3000
}

*.localhost {
	@site header_regexp site Host ^([a-z0-9-]+)\.localhost$

	handle @site {
		root * /home/tejashvi/projects/AutoDeploy/sites/{re.site.1}
		encode zstd gzip
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		respond "Not found" 404
	}
}